# Code Together Production Configuration
# Copy this file to .env and update the values

# ============================================================================
# REQUIRED: Security Configuration
# ============================================================================

# JWT Secret for token signing (REQUIRED - must be changed from default!)
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL credentials
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_NAME=your_database_name
DB_PORT=5432

# ============================================================================
# Application Configuration
# ============================================================================

# External application port (default: 8080)
# This is the only port exposed - it serves both UI and API
APP_PORT=8080

# Enable debug mode (default: false)
DEBUG=false

# ============================================================================
# Docker Image Configuration
# ============================================================================

# GitHub repository (format: owner/repo-name)
# Example: your-org/your-repo
GITHUB_REPOSITORY=your-org/your-repo

# Image tag (default: latest)
# Use version tags for production: v1.0.0, v1.1.0, etc.
IMAGE_TAG=latest

# ============================================================================
# Optional: Default Admin Account Override
# ============================================================================
# By default, a random 8-character password is generated on first run
# Uncomment to override default admin credentials:

# ADMIN_EMAIL=admin@codetogether.local
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=your_secure_password

# ============================================================================
# Notes:
# ============================================================================
# 1. On first run, if no admin credentials are provided, a random password
#    will be generated and displayed in the logs and saved to admin_credentials.txt
# 2. Make sure to change the JWT_SECRET before deploying to production!
# 3. After first login, immediately change the default admin password
# ============================================================================
