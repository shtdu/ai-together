{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Runs when Claude Code finishes responding",
  "properties": {
    "cwd": {
      "description": "Current working directory",
      "type": "string"
    },
    "permission_mode": {
      "description": "Permission mode (e.g., 'default', 'acceptEdits')",
      "type": "string"
    },
    "session_id": {
      "description": "Unique identifier for session",
      "type": "string"
    },
    "stop_hook_active": {
      "description": "Whether the stop hook is active",
      "type": "boolean"
    },
    "transcript_path": {
      "description": "Path to the transcript file",
      "type": "string"
    }
  },
  "required": [
    "cwd",
    "permission_mode",
    "session_id",
    "stop_hook_active",
    "transcript_path"
  ],
  "title": "Stop",
  "type": "object"
}
