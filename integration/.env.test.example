# Integration Test Environment Configuration Template
# Copy this file to .env.test and configure with your local settings
# The .env.test file should NOT be committed to git (see .gitignore)
#
# This configures both the integration tests AND the test server instance
#
# Usage: cp .env.test.example .env.test

# ============================================================================
# Test Server Configuration
# ============================================================================

# Test server URL (external test server on port 8088)
TEST_SERVER_URL=http://localhost:8088

# ============================================================================
# Database Configuration
# ============================================================================

# Test Database URL (required)
# Integration tests and test server both use this database
# Update with your PostgreSQL credentials
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/your_test_db?sslmode=disable

# Server also uses TEST_DATABASE_URL when running in test mode
DATABASE_URL=postgres://postgres:postgres@localhost:5432/your_test_db?sslmode=disable

# ============================================================================
# Security Configuration
# ============================================================================

# JWT Secret for token generation and verification (required)
JWT_SECRET=default_secret_key_for_development

# License Public Key (Ed25519, base64-encoded) (required for license tests)
# Generate with: cd server && go run scripts/keygen/main.go
LICENSE_PUBLIC_KEY=+ftu10SQxIREoOQ3lHpJl0tr2pnPtuBVJCUbcRMDQKw=

# ============================================================================
# Integration Test Configuration (optional)
# ============================================================================

# Enable verbose test output
# TEST_DEBUG=false

# Test server port (for starting test server)
# TEST_SERVER_PORT=8088

# ============================================================================
# Test API Keys (Optional - for provider connectivity tests only)
# ============================================================================
# WARNING: Never use real production API keys! These are only for testing.
# Most tests work with fake keys in the correct format.

# Claude API key (any key starting with "sk-ant-" works for tests)
# TEST_CLAUDE_API_KEY=sk-ant-test-key-12345

# OpenAI API key (any key starting with "sk-" works for tests)
# TEST_OPENAI_API_KEY=sk-test-key-67890

# Codex API key (any format works for tests)
# TEST_CODEX_API_KEY=test-codex-key
